{
  "permissions": {
    "ask": [
      "Edit(/libs/sound/timeline-processor.js)",
      "Edit(/libs/app-common/subdivision.js)",
      "Edit(/libs/app-common/audio-schedule.js)",
      "Edit(/libs/sound/index.js)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh" }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-nivell1.mjs" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/related-tests.mjs", "timeout": 120 }
        ]
      }
    ]
  }
}
